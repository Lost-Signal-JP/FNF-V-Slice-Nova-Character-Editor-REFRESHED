<?xml version="1.0" encoding="utf-8" ?>
<dialog width="600" height="220" title="Icon Data" closable="true" draggable="false">
	<hbox width="100%" height="100%">
		<listview width="23%" height="100%" id="iconAnimationList">
			<data/>
		</listview>
		<spacer width="1%" height="100%"/> 
		<listview width="29%" height="100%" id="iconPreviewWindow">
			
		</listview>
		<spacer width="1%" height="100%"/> 
		<grid width="46%" height="100%">
			<label text="Icon ID:" style="padding: 2px;" verticalAlign="center" />
        	<textfield id="iconID" placeholder="bf " width="100%" verticalAlign="center" />

			<label text="Offsets:" style="padding: 2px;" verticalAlign="center" />
			<hbox width="100%">
				<number-stepper id="iconOffsetX" step="1" width="100%" verticalAlign="center"/>
				<number-stepper id="iconOffsetY" step="1" width="100%" verticalAlign="center"/>
			</hbox>

			<label text="Scale:" style="padding: 2px;" verticalAlign="center" />
        	<number-stepper id="iconScaleStepper" min="0" step="0.1" width="100%" verticalAlign="center"/>

			<label text="Flip X: " style="padding: 2px;" verticalAlign="center" />
			<option-stepper id="iconFlipX" width="100%" verticalAlign="center"> 
				<data>
					<item text="True" id="true" />
					<item text="False" id="false" />
				</data>
			</option-stepper>

			<label text="Is Pixel: " style="padding: 2px;" verticalAlign="center" />
			<option-stepper id="iconIsPixel" width="100%" verticalAlign="center"> 
				<data>
					<item text="True" id="true" />
					<item text="False" id="false" />
				</data>
			</option-stepper>
		</grid>
	</hbox>
</dialog>