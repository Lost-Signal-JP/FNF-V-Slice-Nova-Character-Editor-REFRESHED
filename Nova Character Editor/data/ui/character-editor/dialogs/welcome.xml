<?xml version="1.0" encoding="utf-8"?>
<dialog width="800" height="500" title="Nova Character Creator - New Character" draggable="false">
	<!-- Body -->
	<hbox width="100%" height="100%">
		<card id="splashSectionLeft" width="33%" height="100%" text="Open Recent">
			<scrollview width="100%" height="50%" contentWidth="100%">
				<vbox width="100%" id="splashRecentContainer" />
			</scrollview>
			<!-- <button id="splashBrowse" text="Browse for Character" tooltip="For V-Slice Format Characters"/> -->
		</card>
		<vbox width="33%" height="100%">
			<card id="splashSectionCenter" width="100%" height="50%" text="Create New">
				<link id="splashCreateSparrow" width="100%" text="Sparrow"/>
				<link id="splashCreateAnimateAtlas" width="100%" text="Texture Atlas" tooltip="Animate Atlas"/>
				<!-- <link id="splashCreateMultiSparrow" width="100%" text="Multi-Sparrow"/>
				<link id="splashCreateMultiAnimateAtlas" width="100%" text="Multi-Texture Atlas" tooltip="Multi-Animate Atlas"/> -->
			</card>
			<card id="splashSectionCenter" width="100%" height="50%" text="Import Character">
				<link id="splashImportCharacterCNE" width="100%" text="Codename Engine" />
				<link id="splashImportCharacterPsych" width="100%" text="Psych Engine" />
			</card>
		</vbox>
		<card id="splashSectionRight" width="34%" height="100%" text="Open Existing">
			<scrollview width="100%" height="100%" contentWidth="100%">
				<vbox width="100%" id="splashTemplateContainer" />
			</scrollview>
		</card>
		<!-- <hbox width="10%" height="100%" id="spriteBox">
			<sparrow-player id="boyfriendDJ" xmlFile="assets/images/freeplay/bfFreeplay.xml" pngFile="assets/images/freeplay/bfFreeplay.png" animationName="idle" width="192" height="224" verticalAlign="bottom">
				<data>
					<set name="idle" prefix="Boyfriend DJ0" frameRate="24" looped="true" />
				</data>
			</sparrow-player>
		</hbox> -->
	</hbox>
</dialog>