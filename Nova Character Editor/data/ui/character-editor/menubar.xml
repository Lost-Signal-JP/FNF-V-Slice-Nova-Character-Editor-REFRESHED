<?xml version="1.0" encoding="utf-8"?>
<menubar id="menubar" width="100%" height="5%">
    <style>
        .menu {
        // The width of the individual menu items
        width: 120px;
        }
    </style>

    <menu text="File" width="350">
        <menu-item id="newCharacter" text="New" shortcutText="Ctrl+N" />
        <menu-separator />
        <menu-item id="saveCharacter" text="Save" shortcutText="Ctrl+S" />
        <menu-item id="saveFilePsych" text="Save for Psych Engine" disabled="true" />
        <menu-item id="saveFileCNE" text="Save for Codename Engine" disabled="true" />
        <menu-separator />
        <!-- <menu-item id="deleteCharacter" text="Delete Character" style="color: indianred"/>
        <menu-separator /> -->
        <menu-item id="exitToMenu" text="Exit To Menu" shortcutText="Ctrl+Q" />
    </menu>

    <menu text="Edit" width="350">
        <menu-item id="editHealthIcon" text="Edit Health Icon"/>
        <menu-item id="editCopyOffests" text="Copy Offsets" shortcutText="Ctrl+C" />
        <menu-item id="editPasteOffsets" text="Paste Offsets" shortcutText="Ctrl+V" />
        <menu-item id="editClearOffsets" text="Clear Offsets" />
        <menu-separator />
        <menu-item id="editNewAnimation" text="New Animation" shortcutText="Ctrl+Shift+N" />
        <menu-item id="editDeleteAnimation" text="Delete Animation" shortcutText="Ctrl+Del" />
        <menu-item id="editDuplicateAnimation" text="Duplicate Animation" shortcutText="Ctrl+D" />
        <menu-separator />
        <menu-item id="editClearAllOffsets" text="Clear All Animation Offsets"
            shortcutText="Ctrl+Shift+Del" />
    </menu>

    <menu text="View" width="350">
        <menu-item id="viewResetZoom" text="Reset Zoom" shortcutText="Ctrl+R" />
    </menu>

    <menu text="Help" width="350">
        <menu-item id="helpDownloadEditor" text="Re-Downlaod Editor" shortcutText="Ctrl+Shift+R"
            disabled="true" />
        <menu-item id="helpUpdateEditor" text="Update Editor" shortcutText="Ctrl+U" disabled="true" />
        <menu-item id="helpUserGuide" text="User Guide" shortcutText="F1" />
    </menu>

    <spacer width="100%" />
    <label text="Nova Character Editor v4.0.0 " verticalAlign="center" id="menuBarTitle" />
</menubar>