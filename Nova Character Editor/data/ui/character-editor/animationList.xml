<listview id="charAnimationList" width="100%" height="180" selectedIndex="0">
    <item-renderer width="100%" layout="horizontal">
        <label id="text" width="100%" verticalAlign="center"/>
        <button id="onion" width="25" height="25" toggle="true">
            <image resource="images/ui/ghost.png" width="13" height="13" style="margin-left: -8px" /> 
        </button>
        <button id="edit" width="25" height="25">
            <image resource="images/ui/pencil.png" width="13" height="13" style="margin-left: -8px" /> 
        </button>
        <button id="delete" width="45" height="25">
            <image resource="images/ui/bin.png" width="13" height="13" style="margin-left: 2px" /> 
        </button>
    </item-renderer>
    <data/>
</listview>