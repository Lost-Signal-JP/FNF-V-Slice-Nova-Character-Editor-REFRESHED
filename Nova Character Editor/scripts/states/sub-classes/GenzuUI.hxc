        FlxG.state.insert(0, GenzuUI.MENU_BAR);
        
        var seperator = new Box();
        seperator.id = "paddingLeft";
        seperator.width = Preferences.debugDisplay.toString() != "Off" ? 240 : 0;
        GenzuUI.MENU_BAR.addComponent(seperator);

