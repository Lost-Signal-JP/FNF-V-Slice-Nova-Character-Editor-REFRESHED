    public static function changeTheme(theme:String) {
        Toolkit.theme = theme;
        Toolkit.styleSheet.parse(".body, .label, .link, .textfield, .textarea { font-name: \"Inconsolata\"; font-size: 14px; font-bold: true; }");

        if (FlxG.state.bg == null) return;
        FlxG.state.bg.alpha = theme == 'dark' ? 0.2 : 1;
    }

    public function processMenu(m, root) {
        var menu = new Menu();
        menu.text = m.title;
        if (m.id != null) menu.id = m.id;
        menu.width = 320;
        root.addComponent(menu);

        for (i in m.items) {
            if (i.menu != null) {
                processMenu(i.data, menu);
                continue;
            }
            
            if (i == "separator") {
                menu.addComponent(new MenuSeparator());
                continue;
            }

            var item = new MenuItem();
            item.text = i.text;
            item.shortcutText = i.shortcut;
            item.id = i.id;
            if (i.onClick != null) item.onClick = i.onClick;
            if (i.disabled != null) item.disabled = i.disabled;
            if (i.enabled != null) item.disabled = !i.enabled;
            menu.addComponent(item);
        }
    }

