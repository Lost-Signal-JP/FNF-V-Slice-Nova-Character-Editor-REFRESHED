    public var isSomethingFocused(get, null):Bool;
    public function get_isSomethingFocused():Bool {
        return FocusManager.instance == null ? new FocusManager().focus : FocusManager.instance.focus != null;
    }
    
    public var focusedObject(get, null):Null<Bool>;
    public function get_focusedObject():Null<Bool> {
        return FocusManager.instance == null ? new FocusManager().focus : FocusManager.instance.focus != null;
    }

    public var isCursorOverHaxeUI(get, never):Bool;
    public function get_isCursorOverHaxeUI():Bool {
        return Screen.instance.hasSolidComponentUnderPoint(FlxG.mouse.viewX, FlxG.mouse.viewY);
    }

